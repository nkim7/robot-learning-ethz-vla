# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Environment variables
.env

data/

# Large artifacts — stored on HuggingFace Hub, use download_models.sh / download_datasets.sh
#
# models/eval3/runtime/ contains inference code that must stay in git.
# Git cannot apply a negation exception inside an ignored parent, so we need
# four lines: ignore models/, un-ignore models/eval3/ so git can descend,
# re-ignore everything inside models/eval3/, then un-ignore runtime/ only.
models/*
!models/eval3/
models/eval3/*
!models/eval3/runtime/
training_pipeline/eval1/data/
training_pipeline/eval2/data/
training_pipeline/eval3/data/
training_pipeline/eval2/eval2_fresh_smolvlm_vqa_lora_r32_online_parsefix/
